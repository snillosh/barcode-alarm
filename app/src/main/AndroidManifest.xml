<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.CAMERA"/>
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM"/>
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"/>
    <uses-permission android:name="android.permission.WAKE_LOCK"/>
    <uses-permission android:name="android.permission.VIBRATE"/>
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED"/>
    <uses-feature android:name="android.hardware.camera" android:required="false"/>
    <application android:theme="@style/AppTheme" android:label="Barcode Alarm" android:allowBackup="false" android:supportsRtl="true">
        <!-- The launcher Activity owns normal pages and in-app navigation. -->
        <activity android:enableOnBackInvokedCallback="true" android:name=".MainActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- A separate lock-screen Activity provides dismissal without owning audio playback. -->
        <activity android:enableOnBackInvokedCallback="true" android:name=".RingActivity" android:exported="false" android:launchMode="singleTask" android:showWhenLocked="true" android:turnScreenOn="true"/>
        <!-- Reuse ZXing camera logic, keeping its window in portrait. -->
        <activity android:name=".PortraitCaptureActivity" android:exported="false" android:screenOrientation="portrait" android:stateNotNeeded="true" android:theme="@style/ScannerTheme"/>
        <!-- Playback survives Activity rotation, backgrounding and scanner use. -->
        <service android:name=".RingService" android:exported="false" android:foregroundServiceType="mediaPlayback"/>
        <!-- AlarmManager delivers explicit one-shot PendingIntents here. -->
        <receiver android:name=".AlarmReceiver" android:exported="false"/>
        <!-- Restore future occurrences after unlock/boot or system time/package changes. -->
        <receiver android:name=".RestoreReceiver" android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED"/>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED"/>
                <action android:name="android.intent.action.TIME_SET"/>
                <action android:name="android.intent.action.TIMEZONE_CHANGED"/>
                <action android:name="android.app.action.SCHEDULE_EXACT_ALARM_PERMISSION_STATE_CHANGED"/>
            </intent-filter>
        </receiver>
    </application>
</manifest>
