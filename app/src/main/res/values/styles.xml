<resources>
 <style name="AppTheme" parent="android:style/Theme.Material.Light.NoActionBar">
  <item name="android:fontFamily">sans</item>
  <item name="android:colorAccent">#245B45</item>
  <item name="android:windowLightStatusBar">true</item>
  <item name="android:windowLightNavigationBar">true</item>
  <item name="android:windowBackground">#F5F7F2</item>
  <item name="android:statusBarColor">#F5F7F2</item>
  <item name="android:navigationBarColor">#F5F7F2</item>
  <item name="android:colorControlActivated">#245B45</item>
 </style>
 <style name="AppTheme.Dark" parent="android:style/Theme.Material.NoActionBar">
  <item name="android:fontFamily">sans</item>
  <item name="android:colorAccent">@color/dark_accent</item>
  <item name="android:colorControlActivated">@color/dark_accent</item>
  <item name="android:windowBackground">@color/dark_background</item>
  <item name="android:colorBackground">@color/dark_background</item>
  <item name="android:textColorPrimary">@color/dark_ink</item>
  <item name="android:textColorSecondary">@color/dark_muted</item>
  <item name="android:statusBarColor">@color/dark_background</item>
  <item name="android:navigationBarColor">@color/dark_background</item>
  <item name="android:windowLightStatusBar">false</item>
  <item name="android:windowLightNavigationBar">false</item>
 </style>
 <style name="ScannerTheme" parent="android:style/Theme.Material.NoActionBar">
  <item name="android:windowActionModeOverlay">true</item>
  <item name="android:windowFullscreen">true</item>
  <item name="android:colorAccent">#A9D7AA</item>
 </style>
</resources>
